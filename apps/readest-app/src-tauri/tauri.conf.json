{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BabelLeaf",
  "mainBinaryName": "babelleaf",
  "identifier": "io.github.sakura99966.babelleaf",
  "version": "../package.json",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default", "desktop-capability"],
      "csp": {
        "default-src": "'self' 'unsafe-inline' blob: data: customprotocol: asset: http://asset.localhost http://rangefile.localhost ipc: http://ipc.localhost",
        "connect-src": "'self' blob: data: asset: http://asset.localhost http://rangefile.localhost ipc: http://ipc.localhost https://api.deepseek.com https://api.openai.com https://api.anthropic.com http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline' blob: asset: http://asset.localhost",
        "font-src": "'self' blob: data: asset: http://asset.localhost tauri:",
        "frame-src": "'self' blob: asset: http://asset.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**",
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$TEMP/**/*",
            "**/Readest/**/*",
            "**/BabelLeaf/**/*",
            "/private/var/mobile/Containers/Data/Application/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "text"
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "infoPlist": "./Info-ios.plist",
      "minimumSystemVersion": "15.0"
    },
    "fileAssociations": [
      {
        "name": "BabelLeaf.EPUB",
        "ext": ["epub"],
        "description": "EPUB file",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.MOBI",
        "ext": ["mobi"],
        "description": "MOBI file",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.AZW",
        "ext": ["azw"],
        "description": "AZW file",
        "mimeType": "application/vnd.amazon.ebook",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.AZW3",
        "ext": ["azw3"],
        "description": "AZW3 file",
        "mimeType": "application/vnd.amazon.mobi8-ebook",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.FB2",
        "ext": ["fb2"],
        "description": "FB2 file",
        "mimeType": "application/x-fictionbook+xml",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.CBZ",
        "ext": ["cbz"],
        "description": "CBZ file",
        "mimeType": "application/vnd.comicbook+zip",
        "role": "Viewer"
      },
      {
        "name": "BabelLeaf.PDF",
        "ext": ["pdf"],
        "description": "PDF file",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "cli": {
      "description": "BabelLeaf CLI",
      "args": [
        {
          "name": "file1",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "file2",
          "index": 2,
          "takesValue": true
        },
        {
          "name": "file3",
          "index": 3,
          "takesValue": true
        },
        {
          "name": "file4",
          "index": 4,
          "takesValue": true
        }
      ]
    },
    "webview-upgrade": {
      "minUpgradeMajor": 121,
      "minSupportedMajor": 92
    }
  }
}
