diff --git a/lib/validate.js b/lib/validate.js
new file mode 100644
index 0000000000000000000000000000000000000000..a18c41c4ea098d25dd36783820074f8d1669e08c
--- /dev/null
+++ b/lib/validate.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// BabelLeaf security backport for GHSA-vfj7-8cjw-p6xm. Bound all public
+// AST walkers, including caller-supplied ASTs; do not recurse to validate.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (depth > 128 || ++count > 200000) {
+      throw new SyntaxError('Brace AST nesting depth or node limit exceeded');
+    }
+    if (!node || typeof node !== 'object') continue;
+    if (seen.has(node)) throw new SyntaxError('Cyclic brace AST nesting');
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
